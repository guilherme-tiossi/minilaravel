<?php

require __DIR__ . '/vendor/autoload.php';

use Core\Framework\Root\Miniartisan;

$app = new Miniartisan();

if (empty($argv[1])) {
    $app->error();
}

switch ($argv[1]) {
    case 'run':
        $app->run();
    case 'help':
        $app->help();
    case 'routes':
        $app->routes();
    case 'queue:work':
        $app->queue($argv[2]);
    default:
        $app->error($argv[1]);
}